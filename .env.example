# ============================================================
# Kwiga — variables d'environnement (exemple, aucun secret réel)
# Copier vers .env et remplir. Ne jamais committer .env.
# ============================================================

NODE_ENV=production

# URL publique
APP_URL=https://kwiga.rwazap.com
SESSION_SECRET=remplacer-par-une-chaine-aleatoire-de-32-octets-minimum

# Stockage privé (base + fichiers). En Docker: /app/data (volume)
DATA_DIR=./data

# Port local interne (lié à 127.0.0.1 derrière Nginx)
PORT=3020

# --- Fournisseur IA du tuteur ---
# Valeurs: null | openrouter | google
AI_PROVIDER=null
AI_MODEL=
AI_API_KEY=
# Tarifs indicatifs par million de tokens (pour l'estimation budgétaire)
AI_PRICE_INPUT_EUR_PER_MTOK=0
AI_PRICE_OUTPUT_EUR_PER_MTOK=0
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=60000

# --- Mentions légales (affichées telles quelles) ---
LEGAL_EDITOR_NAME=
LEGAL_EDITOR_ROLE=
LEGAL_CONTACT_EMAIL=
LEGAL_COUNTRY=
LEGAL_HOSTING=

# --- Limitations ---
MAX_ACTIVE_COURSES=3
MAX_PDF_MB=25
MAX_PDF_PAGES=400
MAX_NOTES_KB=200
MAX_UPLOADS_PER_USER=50
MAX_CONCURRENT_JOBS=1
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
