# ============================================================
# Kwiga — variables d'environnement (exemple, aucun secret réel)
# Copier vers .env et remplir. Ne jamais committer .env.
# ============================================================

NODE_ENV=production

# URL publique
APP_URL=https://kwiga.rwazap.com
SESSION_SECRET=remplacer-par-une-chaine-aleatoire-de-32-octets-minimum

# Stockage privé (base + fichiers). En Docker: /app/data (volume)
DATA_DIR=./data

# Port local interne (lié à 127.0.0.1 derrière Nginx)
PORT=3020

# --- Fournisseur IA du tuteur ---
# Valeurs: null | openrouter | google
# Exemple Google (clé AI Studio) :
#   AI_PROVIDER=google
#   AI_MODEL=gemini-3.5-flash-lite
#   AI_API_KEY=...
# Exemple OpenRouter (modèle gratuit) :
#   AI_PROVIDER=openrouter
#   AI_MODEL=google/gemma-4-31b-it:free
AI_PROVIDER=null
AI_MODEL=
AI_API_KEY=
# Tarifs par million de tokens, en EUR, pour l'estimation budgétaire.
# Tier gratuit Google : laisser 0 (aucun coût facturé).
# Valeurs payantes indicatives Gemini 3.5 Flash-Lite (USD 0,30 / 2,50) :
#   entrée ≈ 0,28 € — sortie ≈ 2,30 € (à ajuster selon le taux du jour).
AI_PRICE_INPUT_EUR_PER_MTOK=0
AI_PRICE_OUTPUT_EUR_PER_MTOK=0
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=60000

# --- Mentions légales (affichées telles quelles) ---
LEGAL_EDITOR_NAME=Keziakdos
LEGAL_EDITOR_ROLE=
LEGAL_CONTACT_EMAIL=keziakdos@gmail.com
LEGAL_COUNTRY=
LEGAL_HOSTING=

# --- Limitations ---
MAX_ACTIVE_COURSES=3
MAX_PDF_MB=25
MAX_PDF_PAGES=400
MAX_NOTES_KB=200
MAX_UPLOADS_PER_USER=50
MAX_CONCURRENT_JOBS=1
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
