{
  "name": "kwiga",
  "version": "0.1.0",
  "private": true,
  "description": "Kwiga — Ma salle de classe : apprentissage des réseaux à partir de vos documents",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "build:cli": "esbuild scripts/seed.ts scripts/migrate.ts scripts/create-admin.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist/cli --external:better-sqlite3 --external:@node-rs/argon2",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.10.0",
    "dompurify": "^3.2.6",
    "mermaid": "^11.12.0",
    "next": "^15.5.4",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "dotenv": "^18.0.10",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
